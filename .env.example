# FUJI FLOW – Environment Configuration
# Environment: local development / enterprise production

PROJECT_NAME="FUJI FLOW"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000
FRONTEND_URL="http://localhost:5173"

# Database Configuration (PostgreSQL 18)
# If PostgreSQL is running on standard port 5432:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fuji_flow
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fuji_flow

# Fallback SQLite DB path (if PostgreSQL is ever unreachable)
SQLITE_FALLBACK_URL=sqlite:///./data/fuji_flow.db

# Security & Authentication
SECRET_KEY="fuji-flow-secret-key-enterprise-production-secure-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin & Analyst Credentials (Created on first run)
DEFAULT_ADMIN_EMAIL=admin@fujikyuko.co.jp
DEFAULT_ADMIN_PASSWORD=FujiFlow2026!
DEFAULT_ADMIN_NAME="System Administrator"

DEFAULT_ANALYST_EMAIL=analyst@fujikyuko.co.jp
DEFAULT_ANALYST_PASSWORD=FujiFlow2026!
DEFAULT_ANALYST_NAME="Senior Business Analyst"

# Storage Directories
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
REPORTS_DIR=./data/reports
RAW_DIR=./data/raw
